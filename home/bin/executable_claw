#!/usr/bin/env bash

if ! command -v nono &>/dev/null; then
  echo "Error: 'nono' is not installed or not in PATH."
  echo ""
  echo "Install via Homebrew:"
  echo "  brew install nono"
  echo ""
  echo "For more info: https://github.com/always-further/nono"
  exit 1
fi

nono run --profile claude-code --allow-cwd --network-profile claude-code -- claude --dangerously-skip-permissions $@
